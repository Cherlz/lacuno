# Server-only. Never expose to the browser or commit a real value.
ANTHROPIC_API_KEY=

# Optional: natural read-aloud of the family brief. Without it the browser voice is used.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: accounts (login/signup) with Auth0. Without these the app runs without accounts.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret for session cookies: openssl rand -hex 32
AUTH0_SECRET=
# APP_BASE_URL=https://your-domain  (optional; inferred from the request if unset)

# Optional: shown on the Help page once set
# NEXT_PUBLIC_SUPPORT_EMAIL=contact@your-domain  (default: lacunohealth@gmail.com)
# NEXT_PUBLIC_DEMO_VIDEO_URL=https://youtu.be/VIDEO_ID

# Optional: "Use my phone number instead" button. Set to 1 only after the Auth0
# passwordless SMS connection is on and enabled for this application.
# NEXT_PUBLIC_PHONE_LOGIN=1

# Optional: phone notifications for visit reminders (see docs/TEAM.md).
# Keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Upstash Redis (Vercel → Storage → Upstash adds KV_REST_API_URL/TOKEN, which also work)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Any long random string; Vercel Cron sends it automatically
# CRON_SECRET=
